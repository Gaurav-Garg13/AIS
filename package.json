{
  "name": "beecmp-project",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run install:all && cd frontend && npm run build",
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  },
  "description": "Hey there! 👋 Welcome to **StudyFlow**, a project I built to stop the \"where did I put that assignment?\" panic and actually start crushing my academic goals. It's more than just a planner—it's a full-blown mission control for students who want to stay ahead without losing their minds.",
